{% include "partials/header.twig" %}
<main class='main-content pt-prime pb-prime' id="app">
	<div class="faq-content">
		<div class="container">
			<div class="breadcrumbs_block">
				{{ breadcrumbs }}
			</div>
			<h1 class="h1 page_title m-0">Часто задаваемые вопросы</h1>
			<div class="faq-content">
				<div class="faq-items d-flex flex-column">
					{% for item in post.meta('вопросы_и_ответы') %}
						<div class="faq-item">
							<div class="faq-item-header d-flex align-items-center justify-content-between">
								<div class="faq-item-name rubik_font d-flex align-items-center">{{ item.вопрос }}</div>
								<div class="faq-item-btn btn justify-content-center">
									<img src="{{ site.theme.link }}/assets/images/dropdown.svg" alt="">
								</div>
							</div>
							<div class="faq-item-content w-100">
								{{ item.ответ }}
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
</main>
{% include "partials/footer.twig" %}
